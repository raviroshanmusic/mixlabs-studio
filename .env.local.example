# Copy to .env.local and fill in. See each service's dashboard for values.

# ── Supabase (database + auth) ────────────────────────────────────────────────
# Public values, safe to expose (RLS protects the data). Read at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Backblaze B2 (file storage, via the S3-compatible API) ────────────────────
# Use a NON-master Application Key scoped to your bucket. Keep these secret.
B2_KEY_ID=your-b2-application-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# ── Resend (transactional email: draft / comment notifications) ───────────────
# Sending-access API key. Auth emails (confirm/reset) are sent via Supabase SMTP,
# which is configured separately in the Supabase dashboard (not here).
RESEND_API_KEY=your-resend-api-key
